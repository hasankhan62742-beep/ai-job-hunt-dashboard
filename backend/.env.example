# Server-side secrets. NEVER commit this file. The frontend never sees these.

# --- LLM for CV analysis (optional; pick ONE — job listings work without either)
# auto = use whichever key is set (Gemini preferred when both exist)
LLM_PROVIDER=auto

# Option A — Google Gemini (FREE tier via Google AI Studio: https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Option B — Anthropic (paid)
ANTHROPIC_API_KEY=
# Verify this model ID in your Anthropic console; change if needed.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional overrides:
# JOBHUNT_DB_PATH=/absolute/path/to/jobhunt.db
# FRONTEND_ORIGIN=https://your-frontend.vercel.app
