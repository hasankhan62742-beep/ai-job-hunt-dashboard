# Server-side secrets. NEVER commit this file. The frontend never sees these.

# --- LLM for CV analysis (optional; pick ONE — job listings work without either)
# auto = use whichever key is set (free-first order: Groq, then Gemini, then Anthropic)
LLM_PROVIDER=auto

# Option A — Groq (FREE tier, no credit card: https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Option B — Google Gemini (FREE tier via Google AI Studio: https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Option C — Anthropic (paid)
ANTHROPIC_API_KEY=
# Verify this model ID in your Anthropic console; change if needed.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional overrides:
# JOBHUNT_DB_PATH=/absolute/path/to/jobhunt.db
# FRONTEND_ORIGIN=https://your-frontend.vercel.app
